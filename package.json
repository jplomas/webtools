{
  "name": "qrl-webtools",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "cd dist && find . -type f ! -name 'index.html' -delete",
    "build:verified": "npm run lint && npm test && npm run build && npm run check:offline",
    "check:offline": "./scripts/check-offline-artifact.sh",
    "serve": "vite preview",
    "test": "node --test",
    "test:browser": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "postinstall": "node scripts/copy-qrllib.mjs"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "6.7.2",
    "@fortawesome/free-solid-svg-icons": "6.7.2",
    "@fortawesome/vue-fontawesome": "3.0.8",
    "@theqrl/qrllib-browserify": "1.1.0",
    "@theqrl/validate-qrl-address": "3.0.1",
    "buffer": "6.0.3",
    "jspdf": "4.2.1",
    "print-js": "1.6.0",
    "scrypt-js": "3.0.1",
    "vue": "3.5.26",
    "vue-router": "4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.1.18",
    "@theqrl/wallet-helpers": "4.0.0",
    "@vitejs/plugin-vue": "6.0.3",
    "@vue/compiler-sfc": "3.5.26",
    "daisyui": "5.5.14",
    "eslint": "10.8.0",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.9.0",
    "lightningcss": "1.30.2",
    "postcss": "8.5.25",
    "postcss-custom-properties": "14.0.6",
    "tailwindcss": "4.1.18",
    "vite": "7.3.6",
    "vite-plugin-singlefile": "2.3.0",
    "vue-eslint-parser": "10.4.1"
  }
}
